{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://evido.cloud/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://evido.cloud/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://evido.cloud/login/oauth2/:path*"
    }
  ]
}